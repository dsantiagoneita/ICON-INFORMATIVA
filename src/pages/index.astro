---
import SeparadorCable from '../components/SeparadorCable.astro';
import Llamado from '../components/Llamado.astro';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import SelectorServicios from '../components/SelectorServicios.astro';
import { empresa, municipios, conexiones, totalMunicipios, enlaceWhatsApp } from '../data/empresa.js';
import { proyectos } from '../data/proyectos.js';

// Mapa esquemático: líneas de la red entre los lugares (sale de src/data/empresa.js)
const pos = Object.fromEntries(municipios.map((m) => [m.nombre, m]));
const lazos = conexiones.map(([a, b]) => `M${pos[a].x} ${pos[a].y} L${pos[b].x} ${pos[b].y}`).join(' ');

// Galería «Nuestro trabajo» (sale de src/data/proyectos.js)
const obras = proyectos.slice(0, 6);
---
<Base
  titulo="ICON Ltda · Redes eléctricas en Boyacá | Sogamoso, Sugamuxi y Duitama"
  descripcion="Contratista de la EBSA con oficina en Duitama. Diseñamos, construimos y mantenemos redes eléctricas de baja y media tensión en Sogamoso y Sugamuxi, Boyacá."
  fichaEmpresa
>
  <!-- Portada -->
  <section class="portada" id="inicio">
    <div class="foto" aria-hidden="true">
      <!-- La escena es más ancha hacia la izquierda (-500): en pantallas anchas los postes quedan a la derecha, fuera del bloque amarillo -->
      <svg viewBox="-500 0 1700 720" preserveAspectRatio="xMaxYMid slice">
        <defs>
          <linearGradient id="cielo-dia" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#9ccbea" />
            <stop offset="1" stop-color="#d4eaf7" />
          </linearGradient>
        </defs>
        <rect class="cielo" x="-500" width="1700" height="720" />
        <rect x="-500" y="470" width="1700" height="250" fill="#3e3e3b" />
        <path d="M-500 500 Q-200 540 0 520 Q300 460 600 510 T1200 490 V720 H-500Z" fill="#33332f" />
        <!-- Tres postes con sus crucetas; los cables entran y salen por los bordes, nunca quedan en el aire -->
        <g stroke="#7d7c76" stroke-width="10"><line x1="560" y1="720" x2="560" y2="185" /><line x1="820" y1="720" x2="820" y2="160" /><line x1="1080" y1="720" x2="1080" y2="210" /></g>
        <g stroke="#7d7c76" stroke-width="6"><line x1="500" y1="200" x2="620" y2="200" /><line x1="760" y1="175" x2="880" y2="175" /><line x1="1020" y1="225" x2="1140" y2="225" /></g>
        <g stroke="#f5b700" stroke-width="2.4" fill="none">
          <path class="cable" d="M-540 260 Q-20 380 500 200" />
          <path class="cable" style="animation-delay:.15s" d="M-540 295 Q40 410 620 200" />
          <path class="cable" style="animation-delay:.45s" d="M500 200 Q650 265 760 175" />
          <path class="cable" style="animation-delay:.6s" d="M620 200 Q760 260 880 175" />
          <path class="cable" style="animation-delay:.9s" d="M760 175 Q900 265 1020 225" />
          <path class="cable" style="animation-delay:1.05s" d="M880 175 Q1010 265 1140 225" />
          <path class="cable" style="animation-delay:1.3s" d="M1140 225 Q1190 250 1240 245" />
        </g>
        <circle class="chispa-portada" cx="1020" cy="225" r="9" fill="#f5b700" />
      </svg>
    </div>
    <div class="curva" aria-hidden="true"></div>
    <div class="contenedor" style="height:100%">
      <div class="contenido">
        <div class="etiqueta sube" style="animation-delay:.6s">Contratista de la EBSA · Zona Sugamuxi</div>
        <h1 class="sube" style="animation-delay:.8s">Energía que conecta a <span class="rota" id="rota" data-lugares={['Sugamuxi', ...municipios.filter((m) => m.tipo !== 'punto').map((m) => m.nombre)].join(',')}><span class="rota-palabra">Sugamuxi</span></span></h1>
        <div class="botones sube" style="animation-delay:1s">
          <span class="iman"><a href="/contacto" class="boton boton-oscuro">Contáctenos <Icono nombre="arrow-right" /></a></span>
          <span class="iman"><a href={enlaceWhatsApp()} target="_blank" rel="noopener" class="boton boton-borde-carbon"><Icono nombre="brand-whatsapp" /> WhatsApp</a></span>
        </div>
      </div>
    </div>
    <a href="#cifras" class="bajar">BAJAR<Icono nombre="chevron-down" /></a>
  </section>

  <!-- Cifras -->
  <div class="cifras" id="cifras">
    <div class="contenedor">
      {empresa.cifras.map((c, i) => (
        <div class={`cifra rev ${i ? 'd' + i : ''}`}>
          <b>{c.valor}{c.sufijo}</b><span class="t">{c.texto}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Quiénes somos -->
  <section class="nosotros">
    <div class="contenedor">
      <div class="rev">
        <span class="etiqueta">Quiénes somos</span>
        <h2 class="titulo-seccion">Redes eléctricas de baja y media tensión</h2>
        <div class="raya"></div>
        <p>Somos una empresa contratista de la Empresa de Energía de Boyacá (EBSA). Diseñamos, construimos y mantenemos redes eléctricas de baja y media tensión en toda la zona Sugamuxi, llevando energía a veredas, barrios y empresas con seguridad, calidad y cumplimiento.</p>
        <p style="margin-top:22px"><a href="/quienes-somos" class="boton boton-borde">Conocer más <Icono nombre="arrow-right" /></a></p>
      </div>
      <div class="marco-foto rev d2">
        <div class="capa" data-profundidad="0.12" aria-hidden="true">
          <svg viewBox="0 0 600 560" preserveAspectRatio="xMidYMid slice">
            <rect width="600" height="560" fill="#6a6a65" /><rect y="380" width="600" height="180" fill="#4e4e4a" />
            <g stroke="#a3a29b" stroke-width="9"><line x1="180" y1="560" x2="180" y2="90" /><line x1="460" y1="560" x2="460" y2="140" /></g>
            <g stroke="#a3a29b" stroke-width="5"><line x1="120" y1="115" x2="240" y2="115" /><line x1="400" y1="165" x2="520" y2="165" /></g>
            <path d="M120 115 Q290 200 400 165 M240 115 Q350 200 520 165" stroke="#d3d1c7" stroke-width="2" fill="none" />
            <circle cx="300" cy="300" r="22" fill="#f5b700" /><rect x="286" y="322" width="28" height="60" rx="8" fill="#f5b700" />
          </svg>
        </div>
        <span class="sello"><Icono nombre="shield-check" /> Contratista EBSA</span>
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section class="servicios" id="servicios">
    <div class="contenedor">
      <SelectorServicios titulo="Lo que hacemos" />
    </div>
  </section>

  <SeparadorCable />

  <!-- Por qué elegirnos -->
  <section class="razones">
    <div class="contenedor">
      <div class="rev"><span class="etiqueta">Por qué elegirnos</span><h2 class="titulo-seccion">Trabajo seguro y a tiempo</h2></div>
      <div class="fila cuatro">
        <div class="razon"><Icono nombre="casco-obra" /><h3>Seguridad primero</h3><p>Personal con equipos de protección y procedimientos de trabajo seguro en cada obra.</p></div>
        <div class="razon"><Icono nombre="rosette-discount-check" /><h3>Calidad</h3><p>Diseñamos y construimos cumpliendo las normas técnicas de la EBSA.</p></div>
        <div class="razon"><Icono nombre="calendar-check" /><h3>Cumplimiento</h3><p>Entregamos las obras en los tiempos acordados con la EBSA y la comunidad.</p></div>
        <div class="razon"><Icono nombre="certificate" /><h3>Personal certificado</h3><p>Técnicos y linieros con experiencia en redes de baja y media tensión.</p></div>
      </div>
    </div>
  </section>

  <!-- Cómo trabajamos -->
  <section class="proceso">
    <div class="contenedor">
      <div class="rev"><span class="etiqueta">Cómo trabajamos</span><h2 class="titulo-seccion">De la idea a la energía</h2></div>
      <div class="pasos" data-energia>
        <div class="via"></div><div class="energia"></div>
        <div class="paso"><div class="punto"><Icono nombre="ruler-2" /></div><h3>Diseño</h3><p>Levantamiento en terreno y diseño de la red.</p></div>
        <div class="paso"><div class="punto"><Icono nombre="file-check" /></div><h3>Aprobación EBSA</h3><p>Revisión y aprobación del proyecto.</p></div>
        <div class="paso"><div class="punto"><Icono nombre="tools" /></div><h3>Construcción</h3><p>Postes, estructuras y conductores.</p></div>
        <div class="paso"><div class="punto"><Icono nombre="bolt" /></div><h3>Entrega</h3><p>Pruebas y puesta en servicio.</p></div>
      </div>
    </div>
  </section>

  <SeparadorCable />

  <!-- Zona: mapa de los lugares donde trabaja ICON -->
  <section class="zona" id="zona">
    <div class="contenedor">
      <div class="rev">
        <span class="etiqueta">Zona de trabajo</span>
        <h2 class="titulo-seccion">Presentes en {totalMunicipios} municipios</h2>
        <div class="raya"></div>
        <p>Diseñamos, construimos y mantenemos redes eléctricas en Sugamuxi y sus alrededores: {totalMunicipios} municipios de Boyacá, además de puntos clave de la red como El Crucero y Vado Hondo.</p>
        <p class="zona-pista">Pase el cursor por el mapa para ver cada lugar.</p>
        <ul class="leyenda-mapa">
          <li><span class="ley-muni"></span> Municipio</li>
          <li><span class="ley-punto"></span> Punto clave de la red</li>
        </ul>
      </div>
      <div class="rev d2">
        <div class="mapa" data-zona>
          <svg viewBox="0 0 620 470" role="img" aria-label={`Esquema de los ${totalMunicipios} municipios y puntos clave donde trabaja ICON: ${municipios.map((m) => m.nombre).join(', ')}`}>
            <path class="borde" d="M30 20 Q300 -6 590 20 Q614 230 590 450 Q300 474 30 450 Q6 230 30 20Z" />
            <path class="lazo" d={lazos} />
            {municipios.map((m, i) => (
              <g class={`muni ${m.tipo === 'punto' ? 'punto-clave' : ''}`} data-i={i}>
                <title>{m.tipo === 'punto' ? `${m.nombre}: ${m.nota}` : m.nombre}</title>
                <circle class="zona-toque" cx={m.x + 26} cy={m.y} r="22" />
                <circle class="halo" cx={m.x} cy={m.y} r="15" />
                {m.tipo === 'punto'
                  ? <rect class="m" x={m.x - 6} y={m.y - 6} width="12" height="12" transform={`rotate(45 ${m.x} ${m.y})`} />
                  : <circle class="m" cx={m.x} cy={m.y} r="6" />}
                <text x={m.x + 19} y={m.y + 4}>{m.nombre}</text>
              </g>
            ))}
          </svg>
        </div>
        <div class="nota">Esquema ilustrativo, no a escala</div>
      </div>
    </div>
  </section>

  <!-- Nuestro trabajo -->
  <section class="proyectos">
    <div class="contenedor">
      <div class="cabeza rev">
        <div><span class="etiqueta">Trabajos realizados</span><h2 class="titulo-seccion">Nuestro trabajo</h2></div>
        <a class="ver-todos" href="/trabajos">Ver todos los trabajos <Icono nombre="arrow-right" /></a>
      </div>
      <div class="galeria">
        <button class="flecha-lado izq" id="ant" type="button" aria-label="Obra anterior"><Icono nombre="chevron-left" /></button>
        <div class="carril" id="carril">
          {obras.map((o) => (
            <article class="obra">
              <div class="img"><img src={o.foto} alt={o.alt} loading="lazy" decoding="async" style={`object-position:${o.posicion}`} /></div>
              <div class="info"><div class="lugar">{o.tipo}</div><h3>{o.titulo}</h3></div>
            </article>
          ))}
        </div>
        <button class="flecha-lado der" id="sig" type="button" aria-label="Obra siguiente"><Icono nombre="chevron-right" /></button>
      </div>
    </div>
  </section>

  <!-- Franja final -->
  <Llamado titulo="¿Tiene un proyecto eléctrico en Boyacá?" mensaje="Hola ICON, tengo un proyecto eléctrico y quisiera una cotización." />
</Base>

<script>
  // Zona de trabajo: el municipio por el que pasa el cursor (o que se toca en el celular)
  // se ilumina en el mapa.
  const zonas = document.querySelectorAll<HTMLElement>('[data-zona]');
  const mapa = document.querySelector<HTMLElement>('.mapa[data-zona]');
  const iluminar = (i: string | null) => {
    document.querySelectorAll<Element>('.mapa .muni').forEach((el) => {
      el.classList.toggle('luz', i !== null && el.getAttribute('data-i') === i);
    });
    mapa?.classList.toggle('con-luz', i !== null);
  };
  zonas.forEach((zona) => {
    zona.querySelectorAll<Element>('[data-i]').forEach((el) => {
      el.addEventListener('pointerenter', () => iluminar(el.getAttribute('data-i')));
      el.addEventListener('click', () => iluminar(el.getAttribute('data-i')));
    });
    zona.addEventListener('pointerleave', (e) => { if ((e as PointerEvent).pointerType === 'mouse') iluminar(null); });
  });
</script>
