---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import SelectorServicios from '../components/SelectorServicios.astro';
import ObraIlustracion from '../components/ObraIlustracion.astro';
import { empresa, municipios, enlaceWhatsApp } from '../data/empresa.js';
import { proyectos } from '../data/proyectos.js';

const lugaresPortada = ['Sogamoso', 'Nobsa', 'Tibasosa', 'Aquitania', 'Iza', 'Firavitoba', 'Monguí', 'Sugamuxi'];

// Mapa esquemático: conexiones entre municipios y orden en que se iluminan
const lazos = 'M230 170 L150 120 M230 170 L240 70 M240 70 L300 40 M230 170 L330 140 M330 140 L380 90 M230 170 L90 180 M230 170 L160 240 M160 240 L110 310 M230 170 L250 250 M250 250 L320 280 M250 250 L250 330 M320 280 L400 330';
const ordenLuz = '5,3,6,1,4,8,7,0,2,10,11,9,12';

// Galería de obras (sale de src/data/proyectos.js)
const obras = proyectos.slice(0, 6);
---
<Base
  titulo="ICON Ltda · Redes eléctricas en Sogamoso y Sugamuxi, Boyacá"
  descripcion="Construcción y mantenimiento de redes eléctricas de baja y media tensión en Sogamoso y los 13 municipios de Sugamuxi, Boyacá. Contratista de la EBSA."
>
  <!-- Portada -->
  <section class="portada" id="inicio">
    <div class="foto" aria-hidden="true">
      <!-- La escena es más ancha hacia la izquierda (-500): en pantallas anchas los postes quedan a la derecha, fuera del bloque amarillo -->
      <svg viewBox="-500 0 1700 720" preserveAspectRatio="xMaxYMid slice">
        <defs>
          <linearGradient id="cielo-dia" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#9ccbea" />
            <stop offset="1" stop-color="#d4eaf7" />
          </linearGradient>
        </defs>
        <rect class="cielo" x="-500" width="1700" height="720" />
        <rect x="-500" y="470" width="1700" height="250" fill="#3e3e3b" />
        <path d="M-500 500 Q-200 540 0 520 Q300 460 600 510 T1200 490 V720 H-500Z" fill="#33332f" />
        <!-- Tres postes con sus crucetas; los cables entran y salen por los bordes, nunca quedan en el aire -->
        <g stroke="#7d7c76" stroke-width="10"><line x1="560" y1="720" x2="560" y2="185" /><line x1="820" y1="720" x2="820" y2="160" /><line x1="1080" y1="720" x2="1080" y2="210" /></g>
        <g stroke="#7d7c76" stroke-width="6"><line x1="500" y1="200" x2="620" y2="200" /><line x1="760" y1="175" x2="880" y2="175" /><line x1="1020" y1="225" x2="1140" y2="225" /></g>
        <g stroke="#f5b700" stroke-width="2.4" fill="none">
          <path class="cable" d="M-540 260 Q-20 380 500 200" />
          <path class="cable" style="animation-delay:.15s" d="M-540 295 Q40 410 620 200" />
          <path class="cable" style="animation-delay:.45s" d="M500 200 Q650 265 760 175" />
          <path class="cable" style="animation-delay:.6s" d="M620 200 Q760 260 880 175" />
          <path class="cable" style="animation-delay:.9s" d="M760 175 Q900 265 1020 225" />
          <path class="cable" style="animation-delay:1.05s" d="M880 175 Q1010 265 1140 225" />
          <path class="cable" style="animation-delay:1.3s" d="M1140 225 Q1190 250 1240 245" />
        </g>
        <circle class="chispa-portada" cx="1020" cy="225" r="9" fill="#f5b700" />
      </svg>
    </div>
    <div class="curva" aria-hidden="true"></div>
    <div class="contenedor" style="height:100%">
      <div class="contenido">
        <div class="etiqueta sube" style="animation-delay:.6s">Contratista de la EBSA · Zona Sugamuxi</div>
        <h1 class="sube" style="animation-delay:.8s">Energía que conecta a <span class="rota" id="rota" data-lugares={lugaresPortada.join(',')}><span>Sogamoso</span></span></h1>
        <div class="botones sube" style="animation-delay:1s">
          <span class="iman"><a href="/contacto" class="boton boton-oscuro">Contáctenos <Icono nombre="arrow-right" /></a></span>
          <span class="iman"><a href={enlaceWhatsApp()} target="_blank" rel="noopener" class="boton boton-borde-carbon"><Icono nombre="brand-whatsapp" /> WhatsApp</a></span>
        </div>
      </div>
    </div>
    <a href="#cifras" class="bajar">BAJAR<Icono nombre="chevron-down" /></a>
  </section>

  <!-- Cifras -->
  <div class="cifras" id="cifras">
    <div class="contenedor">
      {empresa.cifras.map((c, i) => (
        <div class={`cifra rev ${i ? 'd' + i : ''}`}>
          <b><span class="num" data-fin={c.valor}>0</span>{c.sufijo}</b><span class="t">{c.texto}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Quiénes somos -->
  <section class="nosotros">
    <div class="contenedor">
      <div class="rev">
        <span class="etiqueta">Quiénes somos</span>
        <h2 class="titulo-seccion">Redes eléctricas de baja y media tensión</h2>
        <div class="raya"></div>
        <p>Somos una empresa contratista de la Empresa de Energía de Boyacá (EBSA). Diseñamos, construimos y mantenemos redes eléctricas de baja y media tensión en toda la zona Sugamuxi, llevando energía a veredas, barrios y empresas con seguridad, calidad y cumplimiento.</p>
        <p style="margin-top:22px"><a href="/quienes-somos" class="boton boton-borde">Conocer más <Icono nombre="arrow-right" /></a></p>
      </div>
      <div class="marco-foto rev d2">
        <div class="capa" data-profundidad="0.12" aria-hidden="true">
          <svg viewBox="0 0 600 560" preserveAspectRatio="xMidYMid slice">
            <rect width="600" height="560" fill="#6a6a65" /><rect y="380" width="600" height="180" fill="#4e4e4a" />
            <g stroke="#a3a29b" stroke-width="9"><line x1="180" y1="560" x2="180" y2="90" /><line x1="460" y1="560" x2="460" y2="140" /></g>
            <g stroke="#a3a29b" stroke-width="5"><line x1="120" y1="115" x2="240" y2="115" /><line x1="400" y1="165" x2="520" y2="165" /></g>
            <path d="M120 115 Q290 200 400 165 M240 115 Q350 200 520 165" stroke="#d3d1c7" stroke-width="2" fill="none" />
            <circle cx="300" cy="300" r="22" fill="#f5b700" /><rect x="286" y="322" width="28" height="60" rx="8" fill="#f5b700" />
          </svg>
        </div>
        <span class="sello"><Icono nombre="shield-check" /> Contratista EBSA</span>
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section class="servicios" id="servicios">
    <div class="contenedor">
      <SelectorServicios titulo="Lo que hacemos" />
    </div>
  </section>

  <!-- Por qué elegirnos -->
  <section class="razones">
    <div class="contenedor">
      <div class="rev"><span class="etiqueta">Por qué elegirnos</span><h2 class="titulo-seccion">Trabajo seguro y a tiempo</h2></div>
      <div class="fila">
        <div class="razon rev"><Icono nombre="casco-obra" /><h3>Seguridad primero</h3><p>Personal con equipos de protección y procedimientos de trabajo seguro en cada obra.</p></div>
        <div class="razon rev d1"><Icono nombre="calendar-check" /><h3>Cumplimiento</h3><p>Entregamos las obras en los tiempos acordados con la EBSA y la comunidad.</p></div>
        <div class="razon rev d2"><Icono nombre="certificate" /><h3>Personal certificado</h3><p>Técnicos y linieros con experiencia en redes de baja y media tensión.</p></div>
      </div>
    </div>
  </section>

  <!-- Cómo trabajamos -->
  <section class="proceso">
    <div class="contenedor">
      <div class="rev"><span class="etiqueta">Cómo trabajamos</span><h2 class="titulo-seccion">De la idea a la energía</h2></div>
      <div class="pasos" data-energia>
        <div class="via"></div><div class="energia"></div>
        <div class="paso"><div class="punto"><Icono nombre="ruler-2" /></div><h3>Diseño</h3><p>Levantamiento en terreno y diseño de la red.</p></div>
        <div class="paso"><div class="punto"><Icono nombre="file-check" /></div><h3>Aprobación EBSA</h3><p>Revisión y aprobación del proyecto.</p></div>
        <div class="paso"><div class="punto"><Icono nombre="tools" /></div><h3>Construcción</h3><p>Postes, estructuras y conductores.</p></div>
        <div class="paso"><div class="punto"><Icono nombre="bolt" /></div><h3>Entrega</h3><p>Pruebas y puesta en servicio.</p></div>
      </div>
    </div>
  </section>

  <!-- Zona: mapa de los 13 municipios -->
  <section class="zona" id="zona">
    <div class="contenedor">
      <div class="rev">
        <span class="etiqueta">Zona de trabajo</span>
        <h2 class="titulo-seccion">Presentes en toda Sugamuxi</h2>
        <div class="raya"></div>
        <p>Diseñamos, construimos y mantenemos redes eléctricas en los 13 municipios de la provincia de Sugamuxi, en Boyacá.</p>
        <ul class="municipios">
          {municipios.map((m, i) => <li data-i={i}>{m.nombre}</li>)}
        </ul>
      </div>
      <div class="rev d2">
        <div class="mapa">
          <svg viewBox="0 0 520 420" role="img" aria-label="Esquema de los 13 municipios de Sugamuxi" data-orden={ordenLuz}>
            <path class="borde" d="M60 60 Q200 10 330 20 Q450 30 470 120 Q500 230 460 360 Q330 410 200 390 Q70 370 50 260 Q30 150 60 60Z" />
            <path class="lazo" d={lazos} />
            {municipios.map((m, i) => (
              <g id={`m${i}`}>
                <circle class="halo" cx={m.x} cy={m.y} r="9" />
                <circle class="m" cx={m.x} cy={m.y} r="6" />
                <text x={m.x + 13} y={m.y + 4} font-weight={m.nombre === 'Sogamoso' ? '600' : undefined}>{m.nombre}</text>
              </g>
            ))}
          </svg>
        </div>
        <div class="nota">Esquema ilustrativo, no a escala</div>
      </div>
    </div>
  </section>

  <!-- Proyectos -->
  <section class="proyectos">
    <div class="contenedor">
      <div class="cabeza rev">
        <div><span class="etiqueta">Proyectos</span><h2 class="titulo-seccion">Obras destacadas</h2></div>
        <div class="flechas">
          <button id="ant" type="button" aria-label="Obra anterior"><Icono nombre="arrow-left" /></button>
          <button id="sig" type="button" aria-label="Obra siguiente"><Icono nombre="arrow-right" /></button>
        </div>
      </div>
      <div class="carril rev" id="carril">
        {obras.map((o) => (
          <article class="obra">
            <div class="img"><ObraIlustracion tono={o.tono} /></div>
            <div class="info"><div class="lugar"><Icono nombre="map-pin" /> {o.municipio}, Boyacá</div><h3>{o.titulo}</h3></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Franja final -->
  <div class="llamado">
    <div class="contenedor">
      <h2>¿Tiene un proyecto eléctrico en Sugamuxi?</h2>
      <span class="iman"><a href={enlaceWhatsApp('Hola ICON, tengo un proyecto eléctrico y quisiera una cotización.')} target="_blank" rel="noopener" class="boton boton-oscuro">Hablemos <Icono nombre="arrow-right" /></a></span>
    </div>
  </div>
</Base>
