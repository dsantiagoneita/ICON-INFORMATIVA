---
import Base from '../layouts/Base.astro';
import Banda from '../components/Banda.astro';
import Icono from '../components/Icono.astro';
import IconoServicio from '../components/IconoServicio.astro';
import ObraIlustracion from '../components/ObraIlustracion.astro';
import Marquesina from '../components/Marquesina.astro';
import { proyectos } from '../data/proyectos.js';
import { servicios } from '../data/servicios.js';
import { enlaceWhatsApp } from '../data/empresa.js';

const servicio = (slug: string) => servicios.find((s) => s.slug === slug)!;
const municipiosConObra = new Set(proyectos.map((p) => p.municipio)).size;
---
<Base
  titulo="Proyectos · Obras de redes eléctricas en Sugamuxi"
  descripcion="Obras de redes eléctricas de baja y media tensión construidas por ICON Ltda en Sogamoso y los municipios de Sugamuxi, Boyacá."
>
  <Banda titulo="Obras que llevan energía" etiqueta="Proyectos" miga="Proyectos" resumen="Algunas de las redes que hemos construido y mantenido en la zona Sugamuxi.">
    <div class="banda-cifras sube" style="animation-delay:.6s">
      <div class="rev"><b><span class="num" data-fin={proyectos.length}>0</span></b><span>Obras destacadas</span></div>
      <div class="rev d1"><b><span class="num" data-fin={municipiosConObra}>0</span></b><span>Municipios</span></div>
      <div class="rev d2"><b><span class="num" data-fin={servicios.length}>0</span></b><span>Tipos de servicio</span></div>
    </div>
  </Banda>

  <Marquesina />

  <section>
    <div class="contenedor">
      <div class="obras">
        {proyectos.map((p, i) => {
          const s = servicio(p.servicio);
          return (
            <a class={`obra-tarjeta rev ${['', 'd1', 'd2'][i % 3]}`} href={`/servicios/${s.slug}`}>
              <div class="obra-img">
                <ObraIlustracion tono={p.tono} />
                <span class={`obra-servicio ${s.grupo} vivo`}><IconoServicio id={s.icono} /></span>
                <span class="obra-anio">{p.anio}</span>
              </div>
              <div class="obra-info">
                <span class="obra-lugar"><Icono nombre="map-pin" /> {p.municipio}, Boyacá</span>
                <h2>{p.titulo}</h2>
                <p>{p.texto}</p>
                <span class="obra-tipo">{s.titulo} <Icono nombre="arrow-right" /></span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <div class="llamado">
    <div class="contenedor">
      <h2>¿Su obra puede ser la próxima?</h2>
      <span class="iman"><a href={enlaceWhatsApp('Hola ICON, quisiera cotizar una obra.')} target="_blank" rel="noopener" class="boton boton-oscuro"><Icono nombre="brand-whatsapp" /> Cotizar</a></span>
    </div>
  </div>
</Base>
