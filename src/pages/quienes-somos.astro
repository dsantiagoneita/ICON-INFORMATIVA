---
import Base from '../layouts/Base.astro';
import Banda from '../components/Banda.astro';
import Icono from '../components/Icono.astro';
import EnlaceEbsa from '../components/EnlaceEbsa.astro';
import Marquesina from '../components/Marquesina.astro';
import { empresa, enlaceWhatsApp } from '../data/empresa.js';

// PENDIENTE: historia real de ICON (años y hechos)
const historia = [
  { titulo: 'Nace ICON', texto: 'Empezamos en Duitama con un equipo pequeño dedicado a las redes eléctricas.' },
  { titulo: 'Contratistas de la EBSA', texto: 'Comenzamos a construir redes para la Empresa de Energía de Boyacá.' },
  { titulo: 'Toda Sugamuxi', texto: 'Llegamos con nuestras obras a los 13 municipios de la provincia.' },
  { titulo: 'Hoy', texto: 'Diseñamos, construimos y mantenemos redes de baja y media tensión con personal calificado.' },
];
const valores = [
  { icono: 'casco-obra', titulo: 'Seguridad', texto: 'Cada trabajo se hace con equipos de protección y procedimientos seguros.' },
  { icono: 'rosette-discount-check', titulo: 'Calidad', texto: 'Cumplimos las normas técnicas de la EBSA en cada obra.' },
  { icono: 'calendar-check', titulo: 'Cumplimiento', texto: 'Entregamos en los tiempos acordados.' },
  { icono: 'heart-handshake', titulo: 'Comunidad', texto: 'Llevamos energía que mejora la vida de veredas y barrios.' },
];
---
<Base
  titulo="Quiénes somos · Contratistas de la EBSA en Sugamuxi"
  descripcion="ICON Ltda es una empresa de Duitama, contratista de la EBSA, que construye y mantiene redes eléctricas de baja y media tensión en la zona Sugamuxi, Boyacá."
>
  <Banda titulo="Energía hecha en Boyacá" etiqueta="Quiénes somos" miga="Quiénes somos" resumen="Somos una empresa boyacense contratista de la EBSA. Diseñamos, construimos y mantenemos las redes eléctricas que llevan energía a toda la zona Sugamuxi." />

  <!-- Presentación con foto de profundidad -->
  <section class="nosotros">
    <div class="contenedor">
      <div class="rev">
        <span class="etiqueta">Nuestra empresa</span>
        <h2 class="titulo-seccion">Redes de baja y media tensión</h2>
        <div class="raya"></div>
        <p>ICON Ltda trabaja de la mano de la Empresa de Energía de Boyacá (EBSA) construyendo, ampliando y manteniendo redes eléctricas en los municipios de Sugamuxi. Nuestra oficina está en Duitama.</p>
        <p style="margin-top:14px">Nuestro equipo de técnicos y linieros conoce el terreno de la región: veredas de montaña, zonas rurales y cascos urbanos.</p>
      </div>
      <div class="marco-foto rev d2">
        <div class="capa" data-profundidad="0.12" aria-hidden="true">
          <svg viewBox="0 0 600 560" preserveAspectRatio="xMidYMid slice">
            <rect width="600" height="560" fill="#6a6a65" /><rect y="380" width="600" height="180" fill="#4e4e4a" />
            <g stroke="#a3a29b" stroke-width="9"><line x1="180" y1="560" x2="180" y2="90" /><line x1="460" y1="560" x2="460" y2="140" /></g>
            <g stroke="#a3a29b" stroke-width="5"><line x1="120" y1="115" x2="240" y2="115" /><line x1="400" y1="165" x2="520" y2="165" /></g>
            <path d="M120 115 Q290 200 400 165 M240 115 Q350 200 520 165" stroke="#d3d1c7" stroke-width="2" fill="none" />
            <circle cx="300" cy="300" r="22" fill="#f5b700" /><rect x="286" y="322" width="28" height="60" rx="8" fill="#f5b700" />
          </svg>
        </div>
        <span class="sello"><Icono nombre="shield-check" /> Contratista EBSA</span>
      </div>
    </div>
  </section>

  <!-- Cifras -->
  <div class="cifras">
    <div class="contenedor">
      {empresa.cifras.map((c, i) => (
        <div class={`cifra rev ${i ? 'd' + i : ''}`}><b><span class="num" data-fin={c.valor}>0</span>{c.sufijo}</b><span class="t">{c.texto}</span></div>
      ))}
    </div>
  </div>

  <!-- Misión y visión -->
  <section>
    <div class="contenedor mision">
      <div class="mv rev">
        <Icono nombre="target-arrow" />
        <h2>Misión</h2>
        <p>Construir y mantener redes eléctricas seguras y de calidad, que lleven energía confiable a las comunidades de Sugamuxi.</p>
      </div>
      <div class="mv rev d1">
        <Icono nombre="eye" />
        <h2>Visión</h2>
        <p>Ser la empresa de referencia en redes eléctricas de Boyacá por nuestro cumplimiento, seguridad y compromiso con la región.</p>
      </div>
    </div>
  </section>

  <!-- Historia: se energiza al bajar -->
  <section style="background:var(--fondo-2)">
    <div class="contenedor">
      <div class="rev"><span class="etiqueta">Nuestra historia</span><h2 class="titulo-seccion">Así hemos crecido</h2></div>
      <ol class="linea-tiempo" id="linea">
        <span class="via" aria-hidden="true"></span><span class="carga" id="carga" aria-hidden="true"></span>
        {historia.map((h, i) => <li><span class="bola">{i + 1}</span><h3>{h.titulo}</h3><p>{h.texto}</p></li>)}
      </ol>
    </div>
  </section>

  <!-- Valores -->
  <section class="razones">
    <div class="contenedor">
      <div class="rev"><span class="etiqueta">Nuestros valores</span><h2 class="titulo-seccion">Lo que nos mueve</h2></div>
      <div class="fila cuatro">
        {valores.map((v, i) => <div class={`razon rev ${i ? 'd' + Math.min(i, 3) : ''}`}><Icono nombre={v.icono} /><h3>{v.titulo}</h3><p>{v.texto}</p></div>)}
      </div>
    </div>
  </section>

  <!-- Relación con la EBSA -->
  <section class="proceso">
    <div class="contenedor">
      <div class="rev" style="text-align:center"><span class="etiqueta">Nuestro cliente</span><h2 class="titulo-seccion">Trabajamos para la EBSA</h2></div>
      <EnlaceEbsa />
    </div>
  </section>

  <Marquesina />

  <div class="llamado">
    <div class="contenedor">
      <h2>¿Quiere trabajar con nosotros en su proyecto?</h2>
      <span class="iman"><a href={enlaceWhatsApp()} target="_blank" rel="noopener" class="boton boton-oscuro"><Icono nombre="brand-whatsapp" /> Escríbanos</a></span>
    </div>
  </div>
</Base>
