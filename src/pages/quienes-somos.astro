---
import SeparadorCable from '../components/SeparadorCable.astro';
import Llamado from '../components/Llamado.astro';
import Base from '../layouts/Base.astro';
import Banda from '../components/Banda.astro';
import Icono from '../components/Icono.astro';
import EnlaceEbsa from '../components/EnlaceEbsa.astro';
import { enlaceWhatsApp } from '../data/empresa.js';
import { fotoEquipo } from '../data/fotos-servicios.js';

// PENDIENTE: historia real de ICON (años y hechos)
const historia = [
  { titulo: 'Nace ICON', texto: 'Empezamos en Duitama con un equipo pequeño dedicado a las redes eléctricas.' },
  { titulo: 'Contratistas de la EBSA', texto: 'Comenzamos a construir redes para la Empresa de Energía de Boyacá.' },
  { titulo: 'Sugamuxi y más allá', texto: 'Llegamos con nuestras obras a 21 municipios de Sugamuxi, La Libertad y municipios vecinos.' },
  { titulo: 'Hoy', texto: 'Diseñamos, construimos y mantenemos redes de baja y media tensión con personal calificado.' },
];
---
<Base
  titulo="Quiénes somos · Contratistas de la EBSA en Sugamuxi"
  descripcion="ICON Ltda: empresa de Duitama, contratista de la EBSA, que diseña, construye y mantiene redes eléctricas de baja y media tensión en Sugamuxi."
>
  <Banda titulo="Energía hecha en Boyacá" etiqueta="Quiénes somos" miga="Quiénes somos" resumen="Somos una empresa boyacense contratista de la EBSA. Diseñamos, construimos y mantenemos las redes eléctricas que llevan energía a toda la zona Sugamuxi." />

  <!-- Presentación -->
  <section>
    <div class="contenedor intro-empresa con-foto">
      <div>
      <span class="etiqueta">Nuestra empresa</span>
      <h2 class="titulo-seccion">Conocemos el terreno de la región</h2>
      <div class="raya"></div>
      <p>ICON Ltda trabaja de la mano de la Empresa de Energía de Boyacá (EBSA) diseñando, construyendo, ampliando y manteniendo redes eléctricas en 21 municipios de Sugamuxi y sus alrededores. Nuestra oficina está en Duitama.</p>
      <p>Nuestro equipo de técnicos y linieros conoce las condiciones de la región: veredas de montaña, zonas rurales y cascos urbanos.</p>
      </div>
      <figure class="foto-equipo"><img src={fotoEquipo.src} alt={fotoEquipo.alt} loading="lazy" decoding="async" /></figure>
    </div>
  </section>

  <!-- Misión y visión -->
  <section style="padding-top:0">
    <div class="contenedor mision">
      <div class="mv">
        <Icono nombre="target-arrow" />
        <h2>Misión</h2>
        <p>Diseñar, construir y mantener redes eléctricas seguras y de calidad, que lleven energía confiable a las comunidades de Sugamuxi.</p>
      </div>
      <div class="mv">
        <Icono nombre="eye" />
        <h2>Visión</h2>
        <p>Ser la empresa de referencia en redes eléctricas de Boyacá por nuestro cumplimiento, seguridad y compromiso con la región.</p>
      </div>
    </div>
  </section>

  <!-- Historia -->
  <section style="background:var(--fondo-2)">
    <div class="contenedor">
      <span class="etiqueta">Nuestra historia</span><h2 class="titulo-seccion">Así hemos crecido</h2>
      <ol class="linea-tiempo">
        <span class="via" aria-hidden="true"></span><span class="carga" aria-hidden="true"></span>
        {historia.map((h, i) => <li><span class="bola">{i + 1}</span><h3>{h.titulo}</h3><p>{h.texto}</p></li>)}
      </ol>
    </div>
  </section>

  <SeparadorCable />

  <!-- Nuestro cliente: la EBSA -->
  <section>
    <div class="contenedor">
      <div class="cliente-principal">
        <div>
          <span class="etiqueta">Nuestro cliente</span>
          <h2 class="titulo-seccion">Empresa de Energía de Boyacá</h2>
          <div class="raya"></div>
          <p class="texto-2">La EBSA es la empresa que distribuye la energía eléctrica en Boyacá. Como contratistas, diseñamos y ejecutamos obras de construcción y mantenimiento de su red en la zona Sugamuxi, cumpliendo sus normas técnicas y de seguridad.</p>
        </div>
        <EnlaceEbsa />
      </div>
    </div>
  </section>

  <Llamado titulo="¿Quiere trabajar con nosotros en su proyecto?" mensaje="Hola ICON, quisiera información." />
</Base>
