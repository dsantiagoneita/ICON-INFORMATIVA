---
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import IconoServicio from '../../components/IconoServicio.astro';
import { servicios, grupos } from '../../data/servicios.js';
import { empresa, enlaceWhatsApp } from '../../data/empresa.js';
import { fotosServicios } from '../../data/fotos-servicios.js';
import Llamado from '../../components/Llamado.astro';

export function getStaticPaths() {
  return servicios.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const otros = servicios.filter((x) => x.slug !== s.slug);
const wa = enlaceWhatsApp(`Hola ICON, quiero cotizar: ${s.titulo}`);
const fotos = fotosServicios[s.slug];
---
<Base titulo={`${s.titulo} en Boyacá`} descripcion={`${s.corto} ICON Ltda, contratista de la EBSA en Boyacá.`}>
  <!-- Portada del servicio -->
  <div class="banda con-foto">
    {fotos?.portada && <img class="banda-foto" src={fotos.portada} alt="" aria-hidden="true" style={`object-position:${fotos.posicion}`} fetchpriority="high" />}
    <div class="contenedor s-portada">
      <div class={`s-ico ${s.grupo}`}><IconoServicio id={s.icono} /></div>
      <div>
        <nav class="miga" aria-label="Ruta"><a href="/">Inicio</a><Icono nombre="chevron-right" /><a href="/servicios">Servicios</a><Icono nombre="chevron-right" />{s.titulo}</nav>
        <span class="etiqueta">{grupos[s.grupo].nombre} · {s.n}</span>
        <h1>{s.titulo}</h1>
        <p>{s.descripcion}</p>
        <ul class="chips">{s.incluye.map((x) => <li><Icono nombre="check" /> {x}</li>)}</ul>
        <div class="acciones">
          <a class="boton boton-wa" href={wa} target="_blank" rel="noopener"><Icono nombre="brand-whatsapp" />Cotizar este servicio</a>
          <a class="boton boton-borde-claro" href={empresa.telefonoEnlace ? `tel:${empresa.telefonoEnlace}` : '/contacto'}><Icono nombre="phone" />Llamar</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Cuándo se necesita -->
  <section>
    <div class="contenedor">
      <div class="rev"><span class="etiqueta">Cuándo se necesita</span><h2 class="titulo-seccion">¿Es lo que necesita?</h2></div>
      <div class="casos">
        {s.casos.map((c, i) => (
          <div class={`caso rev ${i ? 'd' + i : ''}`}><Icono nombre={c.icono} /><h3>{c.titulo}</h3><p>{c.texto}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cómo lo hacemos -->
  <section style="background:var(--fondo-2)">
    <div class="contenedor">
      <div class="rev"><span class="etiqueta">Cómo lo hacemos</span><h2 class="titulo-seccion">Paso a paso</h2></div>
      <ol class="linea-tiempo" id="linea">
        <span class="via" aria-hidden="true"></span><span class="carga" id="carga" aria-hidden="true"></span>
        {s.pasos.map((p, i) => (
          <li><span class="bola">{i + 1}</span><h3>{p.titulo}</h3><p>{p.texto}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Fotos reales del servicio (solo si hay fotos buenas para este servicio) -->
  {fotos?.galeria?.length > 0 && (
    <section>
      <div class="contenedor">
        <span class="etiqueta">En obra</span><h2 class="titulo-seccion">Trabajos de este tipo</h2>
        <div class={`galeria-servicio n${fotos.galeria.length}`}>
          {fotos.galeria.map((g) => (
            <figure><img src={g.src} alt={g.alt} loading="lazy" decoding="async" /></figure>
          ))}
        </div>
        <p class="galeria-nota">Fotos reales de trabajos de ICON.</p>
      </div>
    </section>
  )}

  <!-- Otros servicios -->
  <section style="background:var(--fondo-2)">
    <div class="contenedor">
      <div class="rev"><span class="etiqueta">También hacemos</span><h2 class="titulo-seccion">Otros servicios</h2></div>
      <div class="otros rev" data-ciclo>
        {otros.map((o) => (
          <a class={`otro ${o.grupo}`} href={`/servicios/${o.slug}`}>
            <span class="ico"><IconoServicio id={o.icono} /></span><span>{o.titulo}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Llamado titulo={`¿Necesita ${s.titulo.toLowerCase()}?`} mensaje={`Hola ICON, quiero cotizar: ${s.titulo}`} />
</Base>
