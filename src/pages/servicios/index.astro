---
import Llamado from '../../components/Llamado.astro';
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import SelectorServicios from '../../components/SelectorServicios.astro';
import { enlaceWhatsApp } from '../../data/empresa.js';
---
<Base
  titulo="Servicios de redes eléctricas en Sogamoso y Sugamuxi"
  descripcion="Construcción y mantenimiento de redes de baja y media tensión, montaje de transformadores, postería, acometidas y remodelación de redes en Sugamuxi, Boyacá."
>
  <div class="banda">
    <div class="contenedor">
      <nav class="miga" aria-label="Ruta"><a href="/">Inicio</a><Icono nombre="chevron-right" />Servicios</nav>
      <span class="etiqueta">Servicios</span>
      <h1>Construcción y mantenimiento de redes eléctricas</h1>
      <p>Redes de baja y media tensión en 21 municipios de Sugamuxi y sus alrededores, bajo las normas de la EBSA.</p>
    </div>
  </div>

  <section class="servicios">
    <div class="contenedor">
      <SelectorServicios titulo="Elija un servicio" etiqueta="8 servicios en 2 grupos" />
    </div>
  </section>

  <Llamado titulo="¿No sabe cuál servicio necesita?" mensaje="Hola ICON, necesito asesoría para un trabajo eléctrico." />
</Base>
