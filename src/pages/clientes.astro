---
import Base from '../layouts/Base.astro';
import Banda from '../components/Banda.astro';
import Icono from '../components/Icono.astro';
import IconoServicio from '../components/IconoServicio.astro';
import EnlaceEbsa from '../components/EnlaceEbsa.astro';
import Marquesina from '../components/Marquesina.astro';
import { servicios } from '../data/servicios.js';
import { enlaceWhatsApp } from '../data/empresa.js';
---
<Base
  titulo="Clientes · Contratistas de la EBSA en Boyacá"
  descripcion="ICON Ltda es contratista de la EBSA (Empresa de Energía de Boyacá) en la construcción y mantenimiento de redes eléctricas de la zona Sugamuxi."
>
  <Banda titulo="Contratistas de la EBSA" etiqueta="Clientes" miga="Clientes" resumen="Diseñamos, construimos y mantenemos redes para la Empresa de Energía de Boyacá en toda la zona Sugamuxi." />

  <!-- Cliente principal -->
  <section>
    <div class="contenedor">
      <div class="cliente-principal">
        <div class="rev">
          <span class="etiqueta">Cliente principal</span>
          <h2 class="titulo-seccion">Empresa de Energía de Boyacá</h2>
          <div class="raya"></div>
          <p class="texto-2">La EBSA es la empresa que distribuye la energía eléctrica en Boyacá. Como contratistas, ejecutamos obras de construcción y mantenimiento de su red en la zona Sugamuxi, cumpliendo sus normas técnicas y de seguridad.</p>
        </div>
        <EnlaceEbsa />
      </div>
    </div>
  </section>

  <!-- Qué hacemos para la EBSA: los íconos se animan solos, uno tras otro -->
  <section style="background:var(--fondo-2)">
    <div class="contenedor">
      <div class="rev"><span class="etiqueta">Trabajos que realizamos</span><h2 class="titulo-seccion">Lo que hacemos para la EBSA</h2></div>
      <div class="otros rev" data-ciclo>
        {servicios.map((s) => (
          <a class={`otro ${s.grupo}`} href={`/servicios/${s.slug}`}>
            <span class="ico"><IconoServicio id={s.icono} /></span><span>{s.titulo}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="zona-clientes">
    <div class="contenedor rev" style="text-align:center">
      <span class="etiqueta">Zona de trabajo</span>
      <h2 class="titulo-seccion">13 municipios de Sugamuxi</h2>
    </div>
  </section>
  <Marquesina />

  <div class="llamado">
    <div class="contenedor">
      <h2>¿Tiene un proyecto eléctrico en Sugamuxi?</h2>
      <span class="iman"><a href={enlaceWhatsApp()} target="_blank" rel="noopener" class="boton boton-oscuro"><Icono nombre="brand-whatsapp" /> Hablemos</a></span>
    </div>
  </div>
</Base>
