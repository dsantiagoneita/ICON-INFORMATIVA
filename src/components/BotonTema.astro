---
// Botón de modo claro / oscuro (sol que se convierte en luna).
// Se anima solo con "transform" para que funcione igual en iPhone (Safari) y Android.
---
<button class="tema" id="tema" type="button" aria-label="Cambiar a modo oscuro">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <mask id="mascara-luna">
      <rect x="-4" y="-4" width="32" height="32" fill="#fff" />
      <circle class="sombra" cx="17" cy="7" r="7" fill="#000" />
    </mask>
    <g mask="url(#mascara-luna)"><circle class="sol" cx="12" cy="12" r="9" /></g>
    <g class="rayos"><path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8" /></g>
  </svg>
  <span class="globo" id="globo-tema">Modo oscuro</span>
</button>
