---
// Ilustración provisional de una obra (se reemplaza por foto real).
interface Props { tono: string }
const { tono } = Astro.props;
---
<svg viewBox="0 0 420 250" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <rect width="420" height="250" fill={tono} />
  <rect y="180" width="420" height="70" fill="#00000030" />
  <g stroke="#c9c8c1" stroke-width="7"><line x1="110" y1="250" x2="110" y2="50" /><line x1="320" y1="250" x2="320" y2="70" /></g>
  <g stroke="#c9c8c1" stroke-width="4"><line x1="80" y1="62" x2="140" y2="62" /><line x1="290" y1="82" x2="350" y2="82" /></g>
  <path class="cable-obra" d="M80 62 Q215 130 290 82 M140 62 Q250 130 350 82" stroke="#f5b700" stroke-width="2.2" fill="none" />
  <rect x="0" y="242" width="250" height="8" fill="#f5b700" />
</svg>
