---
import '@fontsource/oswald/500.css';
import '@fontsource/oswald/600.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import Cargador from '../components/Cargador.astro';
import Icono from '../components/Icono.astro';
import { empresa, municipios, enlaceWhatsApp } from '../data/empresa.js';

interface Props {
  titulo: string;
  descripcion: string;
  /** Imagen para compartir en WhatsApp/Facebook (ruta dentro de public/). */
  imagen?: string;
  /** true en Inicio y Contacto: agrega la ficha de empresa local para Google. */
  fichaEmpresa?: boolean;
  /** false en páginas que no deben salir en Google (p. ej. la de error). */
  indexar?: boolean;
}
const { titulo, descripcion, imagen = '/og-imagen.jpg', fichaEmpresa = false, indexar = true } = Astro.props;
const tituloCompleto = titulo.includes('ICON') ? titulo : `${titulo} | ICON Ltda`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenAbs = new URL(imagen, Astro.site);
const sitio = new URL('/', Astro.site).href;

// Ficha de empresa local (datos estructurados de schema.org) que Google usa para entender el negocio
const ficha = {
  '@context': 'https://schema.org',
  '@type': 'Electrician',
  '@id': `${sitio}#empresa`,
  name: 'ICON Ltda',
  description: 'Diseño, construcción y mantenimiento de redes eléctricas de baja y media tensión. Contratista de la EBSA (Empresa de Energía de Boyacá).',
  url: sitio,
  logo: new URL('/icono-512.png', Astro.site).href,
  image: imagenAbs.href,
  telephone: empresa.telefonoEnlace,
  email: empresa.correo,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Calle 11 # 17-46',
    addressLocality: 'Duitama',
    addressRegion: 'Boyacá',
    addressCountry: 'CO',
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '12:00' },
  ],
  areaServed: municipios.filter((m) => m.tipo !== 'punto').map((m) => ({ '@type': 'City', name: `${m.nombre}, Boyacá` })),
  knowsAbout: ['Redes eléctricas de media tensión', 'Redes eléctricas de baja tensión', 'Montaje de transformadores', 'Mantenimiento de redes eléctricas'],
};
---
<!doctype html>
<html lang="es-CO">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{tituloCompleto}</title>
  <meta name="description" content={descripcion} />
  {indexar ? <link rel="canonical" href={canonica} /> : <meta name="robots" content="noindex" />}

  <!-- Íconos -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#1d1d1b" />

  <!-- Vista previa al compartir (WhatsApp, Facebook, LinkedIn, X) -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="ICON Ltda" />
  <meta property="og:locale" content="es_CO" />
  <meta property="og:title" content={tituloCompleto} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:url" content={canonica} />
  <meta property="og:image" content={imagenAbs} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="ICON Ltda · Redes eléctricas de baja y media tensión en Boyacá" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={tituloCompleto} />
  <meta name="twitter:description" content={descripcion} />
  <meta name="twitter:image" content={imagenAbs} />

  {fichaEmpresa && <script type="application/ld+json" set:html={JSON.stringify(ficha)} />}

  <script is:inline>
    // Aplica el tema guardado antes de pintar la página (evita un parpadeo)
    try { const t = localStorage.getItem('tema'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <noscript><style>#cargador { display: none !important; }</style></noscript>
</head>
<body>
  <Cargador />
  <div class="aviso-construccion">Sitio en construcción · algunos textos son provisionales</div>
  <Cabecera />
  <main>
    <slot />
  </main>
  <Pie />
  <a href={enlaceWhatsApp()} class="whatsapp" target="_blank" rel="noopener" aria-label="Escribir por WhatsApp"><Icono nombre="brand-whatsapp" /></a>

  <script>
    import '../scripts/comunes.ts';
  </script>
</body>
</html>
