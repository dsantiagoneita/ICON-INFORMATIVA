---
import '@fontsource/oswald/500.css';
import '@fontsource/oswald/600.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import Icono from '../components/Icono.astro';
import { enlaceWhatsApp } from '../data/empresa.js';

interface Props { titulo: string; descripcion: string }
const { titulo, descripcion } = Astro.props;
const tituloCompleto = titulo.includes('ICON') ? titulo : `${titulo} | ICON Ltda`;
const canonica = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="es-CO">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{tituloCompleto}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonica} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#f5b700" />
  <script is:inline>
    // Aplica el tema guardado antes de pintar la página (evita un parpadeo)
    try { const t = localStorage.getItem('tema'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body>
  <div id="progreso" aria-hidden="true"></div>
  <div class="aviso-construccion">Sitio en construcción · fotos, cifras y datos de contacto son de ejemplo</div>
  <Cabecera />
  <main>
    <slot />
  </main>
  <Pie />
  <a href={enlaceWhatsApp()} class="whatsapp" target="_blank" rel="noopener" aria-label="Escribir por WhatsApp"><Icono nombre="brand-whatsapp" /></a>

  <script>
    import '../scripts/comunes.ts';
  </script>
</body>
</html>
